module mb_usb_hdmi_top(
    input logic Clk,
    input logic reset_rtl_0,
    input logic [1:0] sw_i_char,
    input logic [1:0] sw_i_lvl,
    
    //Replacement for space bar
    input logic jump_i, //Pin J1 could work for another input as well
    
    //USB signals
//    input logic [0:0] gpio_usb_int_tri_i,
//    output logic gpio_usb_rst_tri_o,
//    input logic usb_spi_miso,
//    output logic usb_spi_mosi,
//    output logic usb_spi_sclk,
//    output logic usb_spi_ss,
    
    //UART
    input logic uart_rtl_0_rxd,
    output logic uart_rtl_0_txd,
    
    //HDMI
    output logic hdmi_tmds_clk_n,
    output logic hdmi_tmds_clk_p,
    output logic [2:0]hdmi_tmds_data_n,
    output logic [2:0]hdmi_tmds_data_p,
        
    //HEX displays
    output logic [7:0] hex_segA,
    output logic [3:0] hex_gridA,
    output logic [7:0] hex_segB,
    output logic [3:0] hex_gridB
);
    
    //logic [31:0] keycode0_gpio, keycode1_gpio;
    logic clk_25MHz, clk_125MHz, clk, clk_100MHz;
    logic locked;
    logic [9:0] drawX, drawY, ballxsig, ballysig, ballsizesig;
    
    
    logic [9:0] charxsig, charysig, charsizesig;
    logic render_terrain;
    logic [9:0] spikex, spikey;
    //minimize these by doing module.signal

    logic hsync, vsync, vde;
    logic [3:0] red, green, blue;
    logic [3:0] red_bkg, green_bkg, blue_bkg;
    logic [3:0] red_home, green_home, blue_green;
    logic [3:0] red_ball, green_ball, blue_ball;
//    logic in_game;
    logic [3:0] Object_type; //if 1, platform. if 0, spike.
    logic [9:0] CollisionY_a, Ceiling, Floor;
    logic [3:0] Collision_type_a;
    logic In_home, Game_over, Game_won, In_spaceship;
    logic [1:0] Char_select, Lvl_select;
    logic [15:0] Offset, LvlEnd;

    logic reset_ah;
    assign reset_ah = reset_rtl_0;

    //Hex drivers
    
    //Real Digital VGA to HDMI converter
    hdmi_tx_0 vga_to_hdmi (
        //Clocking and Reset
        .pix_clk(clk_25MHz),
        .pix_clkx5(clk_125MHz),
        .pix_clk_locked(locked),
        //Reset is active LOW
        .rst(reset_ah),
        //Color and Sync Signals
        .red(red),
        .green(green),
        .blue(blue),
        .hsync(hsync),
        .vsync(vsync),
        .vde(vde),
        
        //aux Data (unused)
        .aux0_din(4'b0),
        .aux1_din(4'b0),
        .aux2_din(4'b0),
        .ade(1'b0),
        
        //Differential outputs
        .TMDS_CLK_P(hdmi_tmds_clk_p),          
        .TMDS_CLK_N(hdmi_tmds_clk_n),          
        .TMDS_DATA_P(hdmi_tmds_data_p),         
        .TMDS_DATA_N(hdmi_tmds_data_n)          
    );
    
    mb_usb mb_usb_i (
        .clk_100MHz(Clk),
//        .gpio_usb_int_tri_i(gpio_usb_int_tri_i),
//        .gpio_usb_keycode_0_tri_o(keycode0_gpio),
//        .gpio_usb_keycode_1_tri_o(keycode1_gpio),
//        .gpio_usb_rst_tri_o(gpio_usb_rst_tri_o),
        .reset_rtl_0(reset_ah), //Block designs expect active low reset, all other modules are active high
        .uart_rtl_0_rxd(uart_rtl_0_rxd),
        .uart_rtl_0_txd(uart_rtl_0_txd)
//        .usb_spi_miso(usb_spi_miso),
//        .usb_spi_mosi(usb_spi_mosi),
//        .usb_spi_sclk(usb_spi_sclk),
//        .usb_spi_ss(usb_spi_ss)
    );

        
    //clock wizard configured with a 1x and 5x clock for HDMI
    clk_wiz_0 clk_wiz (
        .clk_out1(clk_25MHz),
        .clk_out2(clk_125MHz),
        .reset(reset_ah),
        .locked(locked),
        .clk_in1(Clk)
    );
    
    //VGA Sync signal generator
    vga_controller vga (
        .pixel_clk(clk_25MHz),
        .reset(reset_ah),
        .hs(hsync),
        .vs(vsync),
        .active_nblank(vde),
        .drawX(drawX),
        .drawY(drawY)
    );    

   // ------------------------------- Start of our modules ---------------------------------

   home_screen home (
        .clk(vsync),
        .rst(reset_ah),
        .in(jump_i),
        .in_home(In_home),
        .game_over(Game_over),
        .game_won(Game_won),
        .sw_i_char(sw_i_char),
        .sw_i_lvl(sw_i_lvl),
        .char_select(Char_select),
        .lvl_select(Lvl_select)
    );
    
    //Sprites:
    sprite_drawer sprite_drawer(
        .vga_clk(clk_25MHz),
        .DrawX(drawX),
        .DrawY(drawY),
        .blank(vde),
        .red(red),
        .green(green),
        .blue(blue),
        //.in_game(in_game),
        
        .offset(Offset),
        .lvlEnd(LvlEnd),

        .CharX(charxsig),
        .CharY(charysig),
        .Char_size(charsizesig),
        .Char_select(Char_select),

        .ObjectX(spikex),
        .ObjectY(spikey),
        .object_on(render_terrain),
        .object_type(Object_type),
        
        .game_over(Game_over),
        .game_won(Game_won),
        .in_home(In_home),
        .in_spaceship(In_spaceship)
    );
    
//   Game logic
    character_jump jump(
        .frame_clk(vsync),
        .Reset(reset_ah),
        .keycode(jump_i),
        .CharX(charxsig),
        .CharY(charysig), 
        .CharS(charsizesig), //tbh this is unnecessary but removing it probably only affords marginal performance benefits so meh
        .collision_Y(CollisionY_a),
        .collision_type(Collision_type_a),
        .ceiling(Ceiling),
        .floor(Floor),
        .game_over(Game_over),
        .game_won(Game_won),
        .in_home(In_home),
        .in_spaceship(In_spaceship)
    );
    
    terrain_motion terrain(
        .Reset(reset_ah),
        .frame_clk(vsync),
        .DrawX(drawX),
        .DrawY(drawY),
        .CharX(charxsig),
        .CharY(charysig),
        .lvl_select(Lvl_select),

        //Rendering info
        .SpikeX(spikex),
        .SpikeY(spikey),
        .render_terrain(render_terrain),
        .object_type(Object_type),
        
        .offset(Offset),
        .lvlEnd(LvlEnd),

        //Collision info
        .collision_Y(CollisionY_a),
        .collision_type(Collision_type_a),
        .ceiling(Ceiling),
        .floor(Floor),

        .in_home(In_home),
        .game_over(Game_over),
        .game_won(Game_won),
        .in_spaceship(In_spaceship)
    );

    
endmodule
