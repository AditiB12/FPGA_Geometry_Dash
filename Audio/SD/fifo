module fifo #(
    parameter WIDTH = 8,
    parameter DEPTH = 4096
)(
    input logic clk,
    input logic rst,
    // Write Interface
    input logic wr_en,
    input logic [WIDTH-1:0] din,
    output logic full,
    // Read Interface
    input logic rd_en,
    output logic [WIDTH-1:0] dout,
    output logic empty,
    output logic [15:0] data_count
);

    logic [WIDTH-1:0] mem [0:DEPTH-1];
    logic [15:0] wr_ptr, rd_ptr;
    logic [15:0] count;

    always_ff @(posedge clk) begin
        if (rst) begin
            wr_ptr <= 0;
            rd_ptr <= 0;
            count <= 0;
        end else begin
            // Write operation
            if (wr_en && !full) begin
                mem[wr_ptr] <= din;
                wr_ptr <= (wr_ptr == DEPTH-1) ? 0 : wr_ptr + 1;
            end
            
            // Read operation
            if (rd_en && !empty) begin
                dout <= mem[rd_ptr];
                rd_ptr <= (rd_ptr == DEPTH-1) ? 0 : rd_ptr + 1;
            end
            
            // Update count
            case ({wr_en && !full, rd_en && !empty})
                2'b01: count <= count - 1;
                2'b10: count <= count + 1;
                2'b11: count <= count;
                default: count <= count;
            endcase
        end
    end

    assign full = (count == DEPTH);
    assign empty = (count == 0);
    assign data_count = count;
endmodule
